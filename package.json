{
  "name": "paypal-retrofit-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Give any existing business a PayPal brain: an open-source agent that retrofits PayPal into legacy systems and keeps them reconciled.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "retrofit": "tsx packages/cli/src/index.ts",
    "mock-paypal": "tsx packages/mock-paypal/src/main.ts",
    "fernhill": "tsx examples/legacy-invoicer/src/server.ts",
    "fernhill:seed": "tsx examples/legacy-invoicer/src/seed.ts",
    "dashboard:dev": "pnpm --filter @paypal-retrofit/dashboard dev",
    "build": "pnpm --filter @paypal-retrofit/dashboard build",
    "start": "tsx packages/cli/src/index.ts serve",
    "demo": "tsx packages/cli/src/index.ts demo",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @paypal-retrofit/dashboard typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke:sandbox": "tsx scripts/sandbox-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5",
    "@paypal-retrofit/core": "workspace:*",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
