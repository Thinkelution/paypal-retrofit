# PayPal developer app (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# SANDBOX (default), or MOCK to use the bundled local PayPal mock (no account needed)
PAYPAL_ENVIRONMENT=SANDBOX
# Returned by `pnpm retrofit webhooks register --url https://<host>/webhooks/paypal`
PAYPAL_WEBHOOK_ID=
# Only for PAYPAL_ENVIRONMENT=MOCK: where the mock listens
PAYPAL_MOCK_URL=http://localhost:8788

# Claude (https://console.anthropic.com). Without it, `init` uses the deterministic mapper and chat is disabled.
ANTHROPIC_API_KEY=
RETROFIT_MODEL=claude-opus-5-5

# Server
PORT=8787
# Protects the hosted dashboard with HTTP basic auth (user: retrofit). Leave empty locally.
RETROFIT_DASHBOARD_PASSWORD=
# Demo only: treat "confirm" policies as "auto"
RETROFIT_AUTO_APPROVE=0
# Refuse PRODUCTION unless this is 1. Live mode is untested.
RETROFIT_ALLOW_LIVE=0

# Owner's daily digest (optional). SMTP URL for email, e.g. smtps://user:pass@smtp.example.com:465
RETROFIT_SMTP_URL=
RETROFIT_DIGEST_FROM=
# Slack incoming webhook for the digest
RETROFIT_SLACK_WEBHOOK_URL=
# Base URL people use to reach the console (links in the digest); defaults from webhook.publicUrl
RETROFIT_PUBLIC_URL=
# Signs one-click approval links. Set it on hosts with a temporary disk so links survive restarts.
RETROFIT_LINK_SECRET=

# MCP endpoint (POST /mcp). Required as a bearer token when RETROFIT_DASHBOARD_PASSWORD is set.
RETROFIT_MCP_TOKEN=
# Let MCP clients approve and reject pending actions (off by default)
RETROFIT_MCP_ALLOW_APPROVE=0
# Setup wizard on the demo: also accept SQLite paths and Postgres URLs (never on a public server)
RETROFIT_SETUP_ALLOW_PATHS=0
